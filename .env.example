# Скопируйте этот файл в .env и заполните нужное.

# Порт и публичный адрес сайта (без слэша в конце).
# На хостинге BASE_URL должен быть вашим https-адресом — от него строится redirect URI для OAuth.
PORT=3000
BASE_URL=http://localhost:3000

# База данных. Если задан DATABASE_URL (Postgres) — используется он; это обязательно для Vercel,
# там переменную добавляет интеграция Storage → Neon. Иначе данные хранятся в файле SQLite.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_PATH=data/chessrank.db

# Chess.com просит указывать в User-Agent, кто делает запросы, и контакт для связи.
CHESSCOM_USER_AGENT=ChessRank/1.0 (contact: your-email@example.com)

# --- Вход через Chess.com OAuth (необязательно) ---
# Ключи выдаёт Chess.com по заявке: https://forms.gle/RwGLuZkwDysCj2GV7
# В заявке укажите redirect URI: <BASE_URL>/auth/chesscom/callback
# Пока CHESSCOM_CLIENT_ID пуст, работает вход через подтверждение профиля.
CHESSCOM_CLIENT_ID=
# Для публичных клиентов с PKCE секрет не нужен.
CHESSCOM_CLIENT_SECRET=
# Scope и прочие параметры уточните в документации, которую Chess.com пришлёт вместе с ключами.
CHESSCOM_OAUTH_SCOPE=openid
# CHESSCOM_OAUTH_AUTHORIZE_URL=https://oauth.chess.com/authorize
# CHESSCOM_OAUTH_TOKEN_URL=https://oauth.chess.com/token
# Если ник приходит не в id_token, а через userinfo-эндпоинт или в другом поле:
# CHESSCOM_OAUTH_USERINFO_URL=
# CHESSCOM_OAUTH_USERNAME_CLAIM=preferred_username
